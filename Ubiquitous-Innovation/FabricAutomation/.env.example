# Copy this file to .env and replace all placeholder values before running .\up.ps1.
# Do not put an Azure password or access token in this file.
AZURE_ENV_NAME=ubiquitous-fabric
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<YOUR_TENANT_ID>
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-Ubiquitous
FABRIC_CAPACITY_ADMIN_UPN=<YOUR_USER_PRINCIPAL_NAME>

# Set to service_principal to sign Azure CLI and Azure Developer CLI in without a
# browser prompt. It reuses SHAREPOINT_CLIENT_ID and SHAREPOINT_CLIENT_SECRET below.
AZURE_AUTH_MODE=interactive

# Optional. Defaults are used when omitted.
# LAKEHOUSE_NAME=Ubiquitous_Lakehouse

# Optional direct SharePoint upload through an existing service principal.
# The client secret remains only in the local .env process environment; it is not
# copied into the azd environment. Never commit a populated .env file.
ENABLE_SHAREPOINT_GRAPH_UPLOAD=false
PROVISION_SHAREPOINT_SITE_WRITE=false
SHAREPOINT_TENANT_ID=<YOUR_TENANT_ID>
SHAREPOINT_CLIENT_ID=<EXISTING_SERVICE_PRINCIPAL_CLIENT_ID>
SHAREPOINT_CLIENT_SECRET=<EXISTING_SERVICE_PRINCIPAL_CLIENT_SECRET>
SHAREPOINT_SITE_URL=<YOUR_SHAREPOINT_SITE_URL>
SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_DESTINATION_FOLDER=Ubiquitous-Innovation
