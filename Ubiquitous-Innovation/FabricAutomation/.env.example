# Copy this file to .env and replace all placeholder values before running .\up.ps1.
# Do not put an Azure password, client secret, or access token in this file.
AZURE_ENV_NAME=ubiquitous-fabric
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<YOUR_TENANT_ID>
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-Ubiquitous
FABRIC_CAPACITY_ADMIN_UPN=<YOUR_USER_PRINCIPAL_NAME>

# Optional. Defaults are used when omitted.
# LAKEHOUSE_NAME=Ubiquitous_Lakehouse
