# Copy this file to .env and replace all placeholders before running .\up.ps1.
# Keep the client secret local and never commit a populated .env file.
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<YOUR_TENANT_ID>
AZURE_CLIENT_ID=<YOUR_SERVICE_PRINCIPAL_CLIENT_ID>
AZURE_CLIENT_SECRET=<YOUR_SERVICE_PRINCIPAL_CLIENT_SECRET>
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-Ubiquitous

# Optional. Defaults to Ubiquitous_Lakehouse when omitted.
# LAKEHOUSE_NAME=Ubiquitous_Lakehouse
