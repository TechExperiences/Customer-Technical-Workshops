# Caldova Unified Data Estate — local environment template
#
# Copy this file to `.env`, replace every <...> placeholder, then run:
#   .\up.ps1
# The command imports this file, creates/selects the azd environment, signs in when
# needed, persists the values to .azure/<environment>/.env, and invokes `azd up`.
# Do not commit a populated .env file.

# Required Azure deployment target. `azd up` prompts for these if they are absent.
AZURE_ENV_NAME=dev
AZURE_SUBSCRIPTION_ID=<LAB_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<LAB_TENANT_ID>
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-Build-Unify

# Fabric capacity administrator. If blank, the automation uses the signed-in Azure CLI user.
# This identity needs Fabric workspace/capacity administration rights.
FABRIC_CAPACITY_ADMIN_UPN=<USER_PRINCIPAL_NAME>

# Microsoft 365 SKU part number used by the idempotent licensing step.
# Keep FABRIC_FREE if that SKU is available in the tenant; otherwise set the exact SKU
# returned by Microsoft Graph /subscribedSkus, such as the tenant's Power BI or Fabric SKU.
FABRIC_LICENSE_SKU_PART_NUMBER=FABRIC_FREE

# Required only for initial Azure SQL logical-server creation.
# `azd up` prompts for this when omitted. Do not put a real password in this file.
# The deployment identity should later use Microsoft Entra authentication for data loading.
SQL_ADMINISTRATOR_PASSWORD=<SET_DURING_AZD_UP>

# Locations and resource names are intentionally not configurable here:
# - Resource group, Azure SQL, and Fabric F16 capacity: West US 2
# - Storage account: West US 3
# - Storage, SQL server, and capacity names are deterministic and globally unique,
#   generated by Bicep from the active subscription and resource-group name.
# - Raw data lands in: data/Analytical, data/BusinessApplication, data/Operational
