            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string"
            },
            "storageLocation": {
              "type": "string"
            },
            "sqlServerName": {
              "type": "string"
            },
            "sqlLocation": {
              "type": "string"
            },
            "sqlAdministratorLogin": {
              "type": "string"
            },
            "sqlAdministratorPassword": {
