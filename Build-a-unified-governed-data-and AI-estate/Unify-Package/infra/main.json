{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "3395334121129834353"
    }
  },
  "parameters": {
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-Build-Unify",
      "metadata": {
        "description": "Name of the Azure resource group that contains the estate."
      }
    },
    "resourceGroupLocation": {
      "type": "string",
      "defaultValue": "westus2",
      "metadata": {
        "description": "Region for the resource group, Azure SQL Server, and Fabric capacity."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(format('stcaldova{0}', take(uniqueString(subscription().id, parameters('resourceGroupName')), 14)))]",
      "metadata": {
        "description": "Globally unique, lowercase Storage Account name (3-24 alphanumeric characters)."
      }
    },
    "storageLocation": {
      "type": "string",
      "defaultValue": "westus3",
      "metadata": {
        "description": "The location for Blob Storage."
      }
    },
    "sqlServerName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Azure SQL logical-server name."
      }
    },
    "sqlAdministratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Temporary SQL administrator password. Store this in Key Vault for production use."
      }
    },
    "sqlAdministratorLogin": {
      "type": "string",
      "defaultValue": "squnify"
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "OperationalData"
    },
    "fabricCapacityName": {
      "type": "string",
      "defaultValue": "[toLower(format('fabriccapacity{0}', take(uniqueString(subscription().id, parameters('resourceGroupName')), 12)))]"
    },
    "fabricCapacityAdministrators": {
      "type": "array",
      "metadata": {
        "description": "UPNs of Fabric capacity administrators."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
