      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.businessApplicationLogicAppPrincipalId.value]"
