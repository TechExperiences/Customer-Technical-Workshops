            "value": "[parameters('storageAccountName')]"
          },
          "storageLocation": {
            "value": "[parameters('storageLocation')]"
          },
          "sqlServerName": {
            "value": "[parameters('sqlServerName')]"
          },
          "sqlLocation": {
            "value": "[parameters('resourceGroupLocation')]"
          },
          "sqlAdministratorLogin": {
            "value": "[parameters('sqlAdministratorLogin')]"
          },
          "sqlAdministratorPassword": {
            "value": "[parameters('sqlAdministratorPassword')]"
          },
          "sqlDatabaseName": {
            "value": "[parameters('sqlDatabaseName')]"
          },
          "fabricCapacityName": {
            "value": "[parameters('fabricCapacityName')]"
          },
          "fabricCapacityLocation": {
            "value": "westus2"
          },
          "fabricCapacityAdministrators": {
            "value": "[parameters('fabricCapacityAdministrators')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
