    "storageAccountName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.storageAccountName.value]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.sqlServerFqdn.value]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.sqlDatabaseName.value]"
    },
    "fabricCapacityResourceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.fabricCapacityResourceId.value]"
    },
    "businessApplicationLogicAppName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'caldova-estate'), '2025-04-01').outputs.businessApplicationLogicAppName.value]"
