# Azure subscription used by azd up or deploy.ps1
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# Optional: required only for a fully unattended Azure sign-in. Do not use a
# personal account password; create a service principal with least-privilege roles.
AZURE_CLIENT_ID=<service-principal-client-id>
AZURE_TENANT_ID=<azure-tenant-id>
AZURE_CLIENT_SECRET=<service-principal-client-secret>

# SQL administrator configuration (do not commit the real password)
SQL_ADMINISTRATOR_LOGIN=sqladmincaldova
SQL_ADMINISTRATOR_PASSWORD=<set-a-strong-password>

# Azure OpenAI configuration for the application
AZURE_OPENAI_ENDPOINT=<use-the-deployed-Azure-OpenAI-endpoint>
AZURE_OPENAI_API_KEY=<retrieve-from-azure-key-vault-or-portal>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_CHAT_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15
