@model SemanticVm
@{ViewData["Title"]="Semantic Search";}<div class="title"><h1>✦ Semantic Search</h1><span>Meaning-based product discovery with Azure OpenAI</span></div><form><input name="q" value="@Model.Query" placeholder="Ask: medicine used to reduce fever"/><button>Ask catalog</button></form>@if(!string.IsNullOrWhiteSpace(Model.Query)){<section class="answer"><h2>Answer</h2><p>@Model.Answer</p></section><section class="panel"><h2>Vector matches</h2><table><tr><th>Product</th><th>Category</th><th>Match</th><th>Context</th></tr>@foreach(var x in Model.Results){<tr><td>@x.Name</td><td>@x.Category</td><td>@x.Score.ToString("P0")</td><td>@x.Content</td></tr>}</table></section>}
