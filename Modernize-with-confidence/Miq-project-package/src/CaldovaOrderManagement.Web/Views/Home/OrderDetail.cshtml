@model OrderDetailVm
@{ ViewData["Title"] = Model.Number; var message = TempData["OrderMessage"] as string; }
@if (message is not null) { <p class="success">@message</p> }
<div class="title"><div><h1>Order @Model.Number</h1><span>Live order detail from Azure SQL Database.</span></div></div>
<section class="detail-grid"><div class="panel"><dl><dt>Order ID</dt><dd>@Model.Id</dd><dt>Customer</dt><dd>@Model.Customer</dd><dt>Order date</dt><dd>@Model.Date.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd><dt>Order status</dt><dd><span class="status">@Model.Status</span></dd></dl></div><div class="panel"><dl><dt>Subtotal</dt><dd>@Model.SubTotal.ToString("C")</dd><dt>Tax</dt><dd>@Model.Tax.ToString("C")</dd><dt>Shipping</dt><dd>@Model.Shipping.ToString("C")</dd><dt>Total</dt><dd><strong>@Model.Total.ToString("C")</strong></dd></dl></div></section>
<section class="panel"><h2>Order lines</h2><table><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr>@foreach(var line in Model.Lines){<tr><td>@line.Sku — @line.ProductName</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("C")</td><td>@line.Total.ToString("C")</td></tr>}</table></section>
<section class="panel status-panel"><h2>Update order status</h2><form asp-action="UpdateOrderStatus"><input type="hidden" name="id" value="@Model.Id"/><select name="status">@foreach (var status in new[]{"Pending","Processing","Shipped","Delivered","Cancelled"}) { if (status == Model.Status) { <option value="@status" selected>@status</option> } else { <option value="@status">@status</option> } }</select><button type="submit">Update status</button></form></section>
