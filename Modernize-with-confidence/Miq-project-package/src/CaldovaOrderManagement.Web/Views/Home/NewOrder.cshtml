@model NewOrderVm
@{ViewData["Title"]="New Order";}<div class="title"><h1>New Order</h1><span>Create an order against the migrated Azure SQL data.</span></div><form method="post" class="order"><label>Customer ID<input asp-for="CustomerId" type="number"/></label><label>Product ID<input asp-for="ProductId" type="number"/></label><label>Quantity<input asp-for="Quantity" type="number" min="1"/></label><button>Create order</button></form>@if(Model.Message is not null){<p class="answer">@Model.Message</p>}<p class="hint">Use Customer Lookup and Product Availability to find IDs.</p>
