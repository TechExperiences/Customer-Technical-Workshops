@model IReadOnlyList<OrderVm>
@{ViewData["Title"]="Order Lookup";}<div class="title"><h1>Order Lookup</h1></div><form><input name="q" value="@ViewBag.Query" placeholder="Order number or customer"/><button>Search</button></form><table><tr><th>Order</th><th>Customer</th><th>Date</th><th>Status</th><th>Total</th></tr>@foreach(var x in Model){<tr><td>@x.Number</td><td>@x.Customer</td><td>@x.Date.ToShortDateString()</td><td>@x.Status</td><td>@x.Total.ToString("C")</td></tr>}</table>
