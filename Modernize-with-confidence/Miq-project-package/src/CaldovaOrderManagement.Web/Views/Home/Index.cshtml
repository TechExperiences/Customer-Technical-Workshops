@model DashboardVm
@{ViewData["Title"]="Dashboard";}
<div class="title"><div><h1>Dashboard</h1><span><i class="live-dot"></i> Live Azure SQL data · updates every 15 seconds</span></div><small id="updated-at">Loading live telemetry…</small></div>
<section class="cards"><div><strong id="kpi-products">@Model.Products</strong><label>Total Products</label></div><div><strong id="kpi-available">@Model.AvailableProducts</strong><label>Available Products</label></div><div><strong id="kpi-orders">@Model.OpenOrders</strong><label>Open Orders</label></div><div><strong id="kpi-shipments">@Model.PendingShipments</strong><label>Pending Shipments</label></div><div><strong id="kpi-searches">@Model.Searches</strong><label>Semantic Searches Run</label></div></section>
<section class="dashboard-charts"><article class="panel chart-panel"><div class="chart-heading"><div><p>Order operations</p><h2>Order status distribution</h2></div><span>Live</span></div><canvas id="orders-chart"></canvas></article><article class="panel chart-panel"><div class="chart-heading"><div><p>AI modernization</p><h2>Vector search match trend</h2></div><span>Live</span></div><canvas id="trend-chart"></canvas></article></section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const palette=['#2679d8','#39a96b','#f5a524','#8b5cf6','#ef6b73'];
  const orderChart=new Chart(document.getElementById('orders-chart'),{type:'doughnut',data:{labels:[],datasets:[{data:[],backgroundColor:palette,borderWidth:0}]},options:{cutout:'67%',plugins:{legend:{position:'bottom',labels:{boxWidth:10,usePointStyle:true,padding:18}}}}});
  const trendChart=new Chart(document.getElementById('trend-chart'),{type:'line',data:{labels:[],datasets:[{data:[],borderColor:'#2679d8',backgroundColor:'rgba(38,121,216,.13)',fill:true,tension:.35,pointRadius:3,pointBackgroundColor:'#2679d8'}]},options:{plugins:{legend:{display:false}},scales:{y:{min:0,max:1,ticks:{callback:v=>`${Math.round(v*100)}%`}},x:{grid:{display:false}}}}});
  async function refresh(){try{const r=await fetch('/dashboard/live',{cache:'no-store',headers:{'Cache-Control':'no-cache'}});if(!r.ok)throw new Error();const d=await r.json();[['products','kpi-products'],['availableProducts','kpi-available'],['openOrders','kpi-orders'],['pendingShipments','kpi-shipments'],['searches','kpi-searches']].forEach(([key,id])=>document.getElementById(id).textContent=d[key]);orderChart.data.labels=d.orderStatuses.map(x=>x.label);orderChart.data.datasets[0].data=d.orderStatuses.map(x=>x.value);orderChart.update();trendChart.data.labels=d.trend.map(x=>new Date(x.date).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}));trendChart.data.datasets[0].data=d.trend.map(x=>x.score);trendChart.update();document.getElementById('updated-at').textContent=`Updated ${new Date().toLocaleTimeString()}`;}catch{document.getElementById('updated-at').textContent='Live data temporarily unavailable';}}
  refresh();window.setInterval(refresh,15000);
})();
</script>
