@model DashboardVm
@{ViewData["Title"]="Dashboard";}<div class="title"><h1>Dashboard</h1><span>Live data from Azure SQL Database · refreshes every 30 seconds</span></div><section class="cards"><div><strong>@Model.Products</strong><label>Total Products</label></div><div><strong>@Model.AvailableProducts</strong><label>Available Products</label></div><div><strong>@Model.OpenOrders</strong><label>Open Orders</label></div><div><strong>@Model.PendingShipments</strong><label>Pending Shipments</label></div><div><strong>@Model.Searches</strong><label>Semantic Searches Run</label></div></section><section class="panel"><h2>✦ Vector Search Trend</h2>@if(Model.Trend.Count==0){<p>No semantic searches have been run yet.</p>}else{<table><tr><th>Search time</th><th>Top match score</th></tr>@foreach(var p in Model.Trend){<tr><td>@p.Date.ToLocalTime()</td><td>@(p.Score.ToString("P0"))</td></tr>}</table>}</section><script>window.setTimeout(() => window.location.reload(), 30000);</script>
