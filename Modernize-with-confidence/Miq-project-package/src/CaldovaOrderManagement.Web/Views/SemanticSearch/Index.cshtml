@model CaldovaOrderManagement.Web.Models.SemanticComparisonVm
@{ ViewData["Title"] = "Semantic Search"; }
<section class="page-head"><div><p class="eyebrow">Azure OpenAI + Azure SQL vector search</p><h1>Semantic Search</h1><p>Compare exact keyword retrieval with meaning-based retrieval from the same live product catalog.</p></div></section>
<form method="get" class="search"><input name="query" value="@Model.Query" placeholder="Try: medicine used to reduce fever" aria-label="Ask a product question"/><button type="submit">Compare search</button></form>
@if (string.IsNullOrWhiteSpace(Model.Query)) { <p class="search-note">The semantic route creates a 1536-dimension embedding for your question, ranks the generated embeddings in Azure SQL, and logs the top result for the dashboard trend.</p> }
@if (!string.IsNullOrWhiteSpace(Model.Query)) { <div class="comparison-grid"><section class="comparison-panel"><p class="eyebrow">Traditional SQL</p><h2>Keyword matches</h2><p class="search-note">Literal matches across product, SKU, and category fields.</p>@if (!Model.TraditionalResults.Any()) { <p>No keyword matches found.</p> } else { <table><thead><tr><th>Product</th><th>Category</th><th>Available</th></tr></thead><tbody>@foreach (var item in Model.TraditionalResults) { <tr><td>@item.Name<br/><small>@item.Sku</small></td><td>@item.Category</td><td>@item.Available</td></tr> }</tbody></table> }</section><section class="comparison-panel"><p class="eyebrow">Semantic vector search</p><h2>Meaning-based matches</h2><div class="semantic-answer"><strong>Catalog answer</strong><br/>@Model.Answer</div>@if (!Model.SemanticResults.Any()) { <p>No semantic matches found.</p> } else { <table><thead><tr><th>Product</th><th>Why it matched</th><th>Score</th></tr></thead><tbody>@foreach (var item in Model.SemanticResults) { <tr><td>@item.Name<br/><small>@item.Category</small></td><td class="result-content">@item.Content</td><td class="result-score">@((item.Score * 100).ToString("0.0"))%</td></tr> }</tbody></table> }</section></div> }
